; =========================================================
; UDEC 2D XZ DUAL-WELL, THREE-PARALLEL-FRACTURE APERTURE STUDY
; UDEC y-coordinate represents physical z-coordinate.
;
; Restores the three-fracture, 1.00 m-spacing geometry and retains the
; established dual-well FM workflow. Fracture contacts are classified as
; PF_1, PF_2, and PF_3 in slot 20 and receive independent apertures while
; well grouping, flow scaling, fast-flow activation, and diagnostics remain
; consistent with the baseline FM template.
; =========================================================

; =========================================================
; USER CASE SELECTION
; =========================================================
[case_tag = 'xz_parallel_nf3_sp100cm_aperture_study']
[model_file = 'UDEC_xz_parallel_fractures_nf3_sp100cm_nb20.3sav']   

model restore [model_file]

; =========================================================
; PARAMETERS
; =========================================================
fish define parameter
    global vers = 1
    global r_dens = 2600.0
    global r_emod = 71e8
    global r_pois = 0.373
    global well_restore_emod = 71e9
    global tens_m = 11e6
    global coh_m  = 18e6
    global fric_m = 52.0
    global tens_res = 0.001 * tens_m
    global coh_res  = 0.001 * coh_m
    global fric_res = 0.25  * fric_m
    global tens_res_i = 8e6
    global coh_res_i  = 18e6
    global fric_res_i = 52.0
    global f_den = 1000.0
    global f_visc = 1e-3
    global pp0    = 0.0
    ; Cubic-law coefficient 1/(12*viscosity): 83.33 Pa^-1 s^-1 for water
    ; with viscosity 1e-3 Pa*s.  Override only when calibrating joint flow.
    global permeability_factor = 1.0 / (12.0 * f_visc)
    global K = r_emod / (3.0 * (1.0 - 2.0 * r_pois))
    global G = r_emod / (2.0 * (1.0 + r_pois))
    global d_min = 0.1
    global stiff = (K + 4.0 * G / 3.0) / d_min
    global kn_ = stiff
    global ks_ = 0.5 * kn_
    global fbulk = r_emod * 0.6e-5 * 1.0
    global sxx0 = -23.8e6
    global szz0 = -24.1e6
    global szz_top = szz0
    global z_top_load = 0.0
    global top_load_tol = 0.05
    global x_min = -9.9
    global x_max =  9.9
    global z_min = -30.1
    global z_max =   0.1
    global x_INJ = -3.0
    global x_PRD =  3.0
    ; Three-fracture geometry: z = -18.5, -17.5, -16.5 m.
    global n_frac = 3
    global frac_spacing = 1.00
    global open_interval_edge_margin = 1.0
    global z_injection_center = -17.5
    global open_interval_half_height = 0.5 * (n_frac - 1) * frac_spacing + open_interval_edge_margin
    global z_open_top = z_injection_center + open_interval_half_height
    global z_open_bot = z_injection_center - open_interval_half_height

    ; The geometry extends every fracture 10% of the well spacing beyond each well.
    global frac_trace_margin_ratio = 0.10
    global frac_trace_margin = frac_trace_margin_ratio * (x_PRD - x_INJ)
    global frac_trace = (x_PRD - x_INJ) + 2.0 * frac_trace_margin
    global frac_origin_x = x_INJ - frac_trace_margin
    global fracture_group_tolerance = 0.02

    ; Independent hydraulic apertures for the three fractures (m).
    ; PF_1: z=-18.5 m; PF_2: z=-17.5 m; PF_3: z=-16.5 m.
    global ap_rockmass = 1e-5
    global ap_PF_1 = 1e-5
    global ap_PF_2 = 5e-5
    global ap_PF_3 = 2e-5

    global open_borehole_half  = 0.055
    global inner_borehole_half = 0.037
    ;global inject_half_x       = 0.004
    global domain_half_x       = 0.055
    global domain_z_pad = 0.02
    global fluid_timestep = 1e-5
    global step_size = 0.2 ;step_size = 0.2
    global run_stop_time = 306.8
    global filename = 'Data_17a_02s_0291-2588s.txt' ;filename_ = 'Data_17a_02s_0291-2588s.txt'
    global flow_scale = 0.000017
    global use_produce_pressure_control = 0
end
[parameter]

model largestrain off
model configure fluid
block mechanical damping global 0.5 0.99 1.05
block fluid crack-flow on

fish define group_contacts_xz
    local c = block.contact.head
    loop while c # 0
        block.contact.group(c,'4') = 'rockmass'
        local cx = block.contact.pos.x(c)
        local cz = block.contact.pos.y(c)
        if math.abs(cx - x_INJ) < open_borehole_half then
            if cz < z_open_top then
                if cz > z_open_bot then
                    block.contact.group(c,'2') = 'open_borehole_INJ'
                    ;block.contact.group(c,'4') = ''
                endif
            endif
        endif
        if math.abs(cx - x_PRD) < open_borehole_half then
            if cz < z_open_top then
                if cz > z_open_bot then
                    block.contact.group(c,'2') = 'open_borehole_PRD'
                    ;block.contact.group(c,'4') = ''
                endif
            endif
        endif

        ; Identify the three horizontal fractures in slot 20. Direct clearing
        ; of slot 4 remains disabled; explicit remove commands follow the loop.
        if cx >= frac_origin_x then
            if cx <= frac_origin_x + frac_trace then
                loop local i (1,n_frac)
                    local z_frac_ = z_injection_center + ...
                        (i - 0.5 * (n_frac + 1)) * frac_spacing
                    if math.abs(cz - z_frac_) <= fracture_group_tolerance then
                        block.contact.group(c,'20') = 'PF_' + string(i)
                        ;block.contact.group(c,'4') = ''
                    endif
                endloop
            endif
        endif
        c = block.contact.next(c)
    endloop
end
[group_contacts_xz]

block contact group 'rockmass' remove slot '4' range group 'open_borehole_INJ' slot '2'
block contact group 'rockmass' remove slot '4' range group 'open_borehole_PRD' slot '2'
block contact group 'rockmass' remove slot '4' range group 'PF_1' slot '20'
block contact group 'rockmass' remove slot '4' range group 'PF_2' slot '20'
block contact group 'rockmass' remove slot '4' range group 'PF_3' slot '20'

fish define group_wall_and_inner_borehole_xz
    local c = block.contact.head
    loop while c # 0
        local cx = block.contact.pos.x(c)
        if block.contact.group(c,'2') = 'open_borehole_INJ' then
            block.contact.group(c) = 'wall_INJ'
            if math.abs(cx - x_INJ) < inner_borehole_half then
                block.contact.group(c) = 'inner_borehole_INJ' 
            endif
        endif
        if block.contact.group(c,'2') = 'open_borehole_PRD' then
            block.contact.group(c) = 'wall_PRD'
            if math.abs(cx - x_PRD) < inner_borehole_half then
                block.contact.group(c) = 'inner_borehole_PRD' 
            endif
        endif
        c = block.contact.next(c)
    endloop
end
[group_wall_and_inner_borehole_xz]

fish define count_well_contacts_xz
    global n_open_borehole_inj = 0
    global n_open_borehole_prd = 0
    global n_pf_1 = 0
    global n_pf_2 = 0
    global n_pf_3 = 0
    local c = block.contact.head
    loop while c # 0
        if block.contact.group(c,'2') = 'open_borehole_INJ' then
            n_open_borehole_inj = n_open_borehole_inj + 1
        endif
        if block.contact.group(c,'2') = 'open_borehole_PRD' then
            n_open_borehole_prd = n_open_borehole_prd + 1
        endif
        if block.contact.group(c,'20') = 'PF_1' then
            n_pf_1 = n_pf_1 + 1
        endif
        if block.contact.group(c,'20') = 'PF_2' then
            n_pf_2 = n_pf_2 + 1
        endif
        if block.contact.group(c,'20') = 'PF_3' then
            n_pf_3 = n_pf_3 + 1
        endif
        c = block.contact.next(c)
    endloop
    io.out('Open-borehole INJ/PRD contacts: ' + string(n_open_borehole_inj) + ' / ' + string(n_open_borehole_prd))
    io.out('PF_1/PF_2/PF_3 contacts: ' + string(n_pf_1) + ' / ' + string(n_pf_2) + ' / ' + string(n_pf_3))
    io.out('PF apertures (m): ' + string(ap_PF_1) + ' / ' + string(ap_PF_2) + ' / ' + string(ap_PF_3))
    if n_open_borehole_inj < 1 then
        io.out('WARNING: no open_borehole_INJ contacts found.')
    endif
    if n_open_borehole_prd < 1 then
        io.out('WARNING: no open_borehole_PRD contacts found.')
    endif
    if n_pf_1 < 1 then
        io.out('ERROR: no PF_1 contacts found.')
        exit
    endif
    if n_pf_2 < 1 then
        io.out('ERROR: no PF_2 contacts found.')
        exit
    endif
    if n_pf_3 < 1 then
        io.out('ERROR: no PF_3 contacts found.')
        exit
    endif
end
[count_well_contacts_xz]

fish define group_well_domains_xz
    local d = block.domain.head
    loop while d # 0
        local dx = block.domain.pos.x(d)
        local dz = block.domain.pos.y(d)
        if math.abs(dx - x_INJ) <= domain_half_x then
            if dz <= z_open_top + domain_z_pad then
                if dz >= z_open_bot - domain_z_pad then
                    block.domain.group(d,'5') = 'inject_domain'
                endif
            endif
        endif
        if math.abs(dx - x_PRD) <= domain_half_x then
            if dz <= z_open_top + domain_z_pad then
                if dz >= z_open_bot - domain_z_pad then
                    block.domain.group(d,'5') = 'produce_domain'
                endif
            endif
        endif
        d = block.domain.next(d)
    endloop
end

[group_well_domains_xz]

fish define count_well_domains_xz
    global n_inject_domain = 0
    global n_produce_domain = 0
    local d = block.domain.head
    loop while d # 0
        if block.domain.group(d,'5') = 'inject_domain' then
            n_inject_domain = n_inject_domain + 1
        endif
        if block.domain.group(d,'5') = 'produce_domain' then
            n_produce_domain = n_produce_domain + 1
        endif
        d = block.domain.next(d)
    endloop
    io.out('Number of inject domains: ' + string(n_inject_domain))
    io.out('Number of produce domains: ' + string(n_produce_domain))
    if n_inject_domain < 1 then
        io.out('ERROR: no inject domains found in the physical XZ open interval.')
        exit
    endif
    if n_produce_domain < 1 then
        io.out('ERROR: no produce domains found in the physical XZ open interval.')
        exit
    endif
end
[count_well_domains_xz]

block zone cmodel assign elastic
block zone property density [r_dens] young [r_emod] poisson [r_pois]
block contact cmodel assign area
block contact property stiffness-normal [kn_] stiffness-shear [ks_] ...
    tension [tens_m] cohesion [coh_m] friction [fric_m] ...
    friction-residual [fric_res] permeability-factor [permeability_factor] ...
    aperture-zero-load [ap_rockmass] aperture-residual [ap_rockmass]

; Fixed spacing, independent aperture classes for the three fractures.
block contact property aperture-zero-load [ap_PF_1] aperture-residual [ap_PF_1] ...
    range group 'PF_1' slot '20'
block contact property aperture-zero-load [ap_PF_2] aperture-residual [ap_PF_2] ...
    range group 'PF_2' slot '20'
block contact property aperture-zero-load [ap_PF_3] aperture-residual [ap_PF_3] ...
    range group 'PF_3' slot '20'

block fluid aperture-minimum [ap_rockmass]
block fluid aperture-max-ratio 200
block fluid property density [f_den] ;viscosity [f_visc]
block edge apply stress 0 0 [szz_top] range position-y [z_top_load - top_load_tol] [z_top_load + top_load_tol]
block gridpoint apply velocity-x 0 range position-x -9.9 9.9 not
block gridpoint apply velocity-x 0 range position-y -30.1 -29.9
block gridpoint apply velocity-y 0 range position-y -30.1 -29.9
block insitu stress [sxx0] 0 [szz0] nodis
block insitu pore-pressure [pp0]
block fluid flow off
block mechanical active on
block fluid property bulk 0
model history name 'unbalanced_force' unbalanced-force
model solve ratio-average 1e-5

block gridpoint initialize displacement 0 0
block contact reset displacement
block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Bohrloch' slot '10'
block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Inject' slot '10'
block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Produce' slot '10'
block zone property young 1000 density 10 range group 'Bohrloch' slot '10'
block zone property young 1000 density 10 range group 'Inject' slot '10'
block zone property young 1000 density 10 range group 'Produce' slot '10'
model solve ratio-average 1e-5

block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Bohrloch' slot '10'
block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Inject' slot '10'
block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Produce' slot '10'
block zone property young [well_restore_emod] density 10 range group 'Bohrloch' slot '10'
block zone property young [well_restore_emod] density 10 range group 'Inject' slot '10'
block zone property young [well_restore_emod] density 10 range group 'Produce' slot '10'
model solve ratio-average 1e-5

block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Bohrloch' slot '10'
block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Inject' slot '10'
block zone initialize stress-xx 0 stress-xy 0 stress-yy 0 range group 'Produce' slot '10'
model solve ratio-average 1e-5

block zone property density [f_den] range group 'Inject' slot '10'
block zone property density [f_den] range group 'Produce' slot '10'
model solve ratio-average 1e-5

[water_save = 'UDEC_XZ_SZZair_parallel_nf3_sp100cm_NUA10-50-20um_dual_well_PRDflow.3sav']
model save [water_save]

; No packer contacts or packer material are used in the simplified geometry.
[ini_save = 'UDEC_XZ_HM_initialized_parallel_nf3_sp100cm_NUA10-50-20um_dual_well_PRDflow.3sav']
model save [ini_save]

fish define set_contact_states_xz
    local c = block.contact.head
    loop while c # 0
        if block.contact.group(c,'2') = 'open_borehole_INJ' then
            block.contact.state(c) = 2
        else
            if block.contact.group(c,'2') = 'open_borehole_PRD' then
                block.contact.state(c) = 2
            else
                block.contact.state(c) = 0
            endif
        endif
        c = block.contact.next(c)
    endloop
end
block contact property stiffness-normal [kn_] stiffness-shear [ks_] ...
    tension [tens_m] cohesion [coh_m] friction [fric_m] ...
    friction-residual [fric_res_i] ...
    range group 'open_borehole_INJ' slot '2'
block contact property stiffness-normal [kn_] stiffness-shear [ks_] ...
    tension [tens_m] cohesion [coh_m] friction [fric_m] ...
    friction-residual [fric_res_i] ...
    range group 'open_borehole_PRD' slot '2'
[set_contact_states_xz]

block gridpoint apply velocity-x 0 range position-x [x_INJ-0.04] [x_INJ+0.04] position-y -25 -10
block gridpoint apply velocity-y 0 range position-x [x_INJ-0.04] [x_INJ+0.04] position-y -25 -10
block gridpoint apply velocity-x 0 range position-x [x_PRD-0.04] [x_PRD+0.04] position-y -25 -10
block gridpoint apply velocity-y 0 range position-x [x_PRD-0.04] [x_PRD+0.04] position-y -25 -10

fish define inject_domain_pressure_average
    local n_ = 0
    local sum_ = 0.0
    local d = block.domain.head
    loop while d # 0
        if block.domain.group(d,'5') = 'inject_domain' then
            sum_ = sum_ + block.domain.pp(d)
            n_ = n_ + 1
        endif
        d = block.domain.next(d)
    endloop
    inject_domain_pressure_average = 0.0
    if n_ > 0 then
        inject_domain_pressure_average = sum_ / n_
    endif
end

fish define produce_domain_pressure_average
    local n_ = 0
    local sum_ = 0.0
    local d = block.domain.head
    loop while d # 0
        if block.domain.group(d,'5') = 'produce_domain' then
            sum_ = sum_ + block.domain.pp(d)
            n_ = n_ + 1
        endif
        d = block.domain.next(d)
    endloop
    produce_domain_pressure_average = 0.0
    if n_ > 0 then
        produce_domain_pressure_average = sum_ / n_
    endif
end

fish define report_well_domain_pressure
    local n_inj_ = 0
    local n_prd_ = 0
    local sum_inj_ = 0.0
    local sum_prd_ = 0.0
    local d = block.domain.head
    loop while d # 0
        if block.domain.group(d,'5') = 'inject_domain' then
            n_inj_ = n_inj_ + 1
            sum_inj_ = sum_inj_ + block.domain.pp(d)
            io.out('INJ domain=' + string(d) + '; x=' + string(block.domain.pos.x(d)) + ...
                   '; y=' + string(block.domain.pos.y(d)) + '; pp=' + string(block.domain.pp(d)))
        endif
        if block.domain.group(d,'5') = 'produce_domain' then
            n_prd_ = n_prd_ + 1
            sum_prd_ = sum_prd_ + block.domain.pp(d)
            io.out('PRD domain=' + string(d) + '; x=' + string(block.domain.pos.x(d)) + ...
                   '; y=' + string(block.domain.pos.y(d)) + '; pp=' + string(block.domain.pp(d)))
        endif
        d = block.domain.next(d)
    endloop
    if n_inj_ > 0 then
        io.out('Average INJ pressure = ' + string(sum_inj_ / n_inj_))
    endif
    if n_prd_ > 0 then
        io.out('Average PRD pressure = ' + string(sum_prd_ / n_prd_))
    endif
end

[io.out('DIAGNOSTIC STEP 1: initial well-domain selection and pressure')]
[report_well_domain_pressure]

fish define set_inject_test_pressure(test_pressure_)
    local d = block.domain.head
    loop while d # 0
        if block.domain.group(d,'5') = 'inject_domain' then
            block.domain.pp(d) = test_pressure_
        endif
        d = block.domain.next(d)
    endloop
end

history purge
history interval 1000
block contact history name 's_normal_INJ' stress-normal [x_INJ+0.05] [z_injection_center]
block contact history name 's_shear_INJ' stress-shear [x_INJ+0.05] [z_injection_center]
block contact history name 'd_normal_INJ_005' displacement-normal [x_INJ+0.05] [z_injection_center]
block contact history name 'd_normal_INJ_050' displacement-normal [x_INJ+0.50] [z_injection_center]
block contact history name 'd_normal_INJ_075' displacement-normal [x_INJ+0.75] [z_injection_center]
block contact history name 'd_normal_INJ_100' displacement-normal [x_INJ+1.00] [z_injection_center]
block contact history name 'd_normal_INJ_150' displacement-normal [x_INJ+1.50] [z_injection_center]
block contact history name 'd_normal_INJ_200' displacement-normal [x_INJ+2.00] [z_injection_center]
block contact history name 'd_normal_PRD_005' displacement-normal [x_PRD-0.05] [z_injection_center]
block contact history name 'd_normal_PRD_050' displacement-normal [x_PRD-0.50] [z_injection_center]
block contact history name 'd_normal_PRD_075' displacement-normal [x_PRD-0.75] [z_injection_center]
block contact history name 'd_normal_PRD_100' displacement-normal [x_PRD-1.00] [z_injection_center]
block contact history name 'd_normal_PRD_150' displacement-normal [x_PRD-1.50] [z_injection_center]
block contact history name 'd_normal_PRD_200' displacement-normal [x_PRD-2.00] [z_injection_center]
model history name 'fluid_time' time-total-fluid
block fluid incompressible time 0
; Preserve the baseline well and near-wall pressure histories, then add
; fracture-specific midpoint histories and two representative points at
; one-quarter and three-quarters of the central INJ-to-PRD path.
block domain history name 'inject_pressure' fluid-pressure [x_INJ] [z_injection_center]
block domain history name 'wall_pressure_INJ' fluid-pressure [x_INJ+0.05] [z_injection_center]
block domain history name 'PF_1_pressure' fluid-pressure [0.5*(x_INJ+x_PRD)] [z_injection_center-frac_spacing]
block domain history name 'PF_2_pressure' fluid-pressure [0.5*(x_INJ+x_PRD)] [z_injection_center]
block domain history name 'PF_3_pressure' fluid-pressure [0.5*(x_INJ+x_PRD)] [z_injection_center+frac_spacing]
block domain history name 'path_pressure_25pct' fluid-pressure [x_INJ+0.25*(x_PRD-x_INJ)] [z_injection_center]
block domain history name 'path_pressure_75pct' fluid-pressure [x_INJ+0.75*(x_PRD-x_INJ)] [z_injection_center]
block domain history name 'produce_pressure' fluid-pressure [x_PRD] [z_injection_center]
block domain history name 'wall_pressure_PRD' fluid-pressure [x_PRD-0.05] [z_injection_center]
model history name 'ratio_solve' solve-ratio
model history name 'timestep' timestep
[fl_r_ = 0.0]
[pi_ = 0.0]
[inject_well_flow_per_domain_ = 0.0]
[inject_well_flow_total_ = 0.0]
[n_inject_well_flow_domains = 0]
[produce_well_flow_per_domain_ = 0.0]
[produce_well_flow_total_ = 0.0]
[n_produce_well_flow_domains = 0]
[commanded_net_well_flow_ = 0.0]
[bleed_input_ = 0.0]
fish history name 'flowrate_input' @fl_r_
fish history name 'interval_pressure' @pi_
fish history name 'inject_well_flow_per_domain_command' @inject_well_flow_per_domain_
fish history name 'inject_well_flow_total_command' @inject_well_flow_total_
fish history name 'inject_well_flow_domain_count' @n_inject_well_flow_domains
fish history name 'produce_well_flow_per_domain_command' @produce_well_flow_per_domain_
fish history name 'produce_well_flow_total_command' @produce_well_flow_total_
fish history name 'produce_well_flow_domain_count' @n_produce_well_flow_domains
fish history name 'commanded_net_well_flow' @commanded_net_well_flow_
fish history name 'bleed_input' @bleed_input_
fish history name 'inject_domain_pressure_average' @inject_domain_pressure_average
fish history name 'produce_domain_pressure_average' @produce_domain_pressure_average

fish define set_fluid_bulk
    io.out('Effective fluid bulk modulus: ' + string(fbulk))
    io.out('Prescribed incompressible fluid timestep: ' + string(fluid_timestep))
    command
        block mechanical active on
        ; Initial mechanical staging used bulk = 0. Restore the required nonzero
        ; fluid bulk modulus before enabling flow so well sources can change pp.
        ;block fluid property bulk [fbulk]
        ;block contact freeze-new on
        block fluid incompressible on time 290.8 timestep [fluid_timestep] substep-flow 1 substep-mechanical 4
        block fluid flow on
    endcommand
    io.out('set_fluid_bulk completed successfully.')
    io.out('Incompressible flow and mechanics active; flow/mechanical substeps = 1/4.')
end


fish define ApplyInjectWellFlow_xz(flow_per_domain_)
    global n_inject_well_flow_domains = 0
    global inject_well_flow_per_domain_ = flow_per_domain_
    global inject_well_flow_total_ = 0.0
    local d = block.domain.head
    loop while d # 0
        if block.domain.group(d,'5') = 'inject_domain' then
            local well_x_ = block.domain.pos.x(d)
            local well_z_ = block.domain.pos.y(d)
            command
                block domain well flow [flow_per_domain_] atdomain [well_x_] [well_z_]
            endcommand
            n_inject_well_flow_domains = n_inject_well_flow_domains + 1
        endif
        d = block.domain.next(d)
    endloop
    inject_well_flow_total_ = inject_well_flow_per_domain_ * n_inject_well_flow_domains
    if flow_per_domain_ # 0.0 then
        io.out('inject well domain count = ' + string(n_inject_well_flow_domains))
        io.out('commanded injection total flow = ' + string(inject_well_flow_total_))
    endif
    if n_inject_well_flow_domains # n_inject_domain then
        io.out('ERROR: inject-domain count changed before applying well flow.')
        exit
    endif
end

