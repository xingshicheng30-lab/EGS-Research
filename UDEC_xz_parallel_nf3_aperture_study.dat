fish define scaled_flowrate(q_input)
    local q_scaled = q_input * flow_scale
    if n_inject_domain < 1 then
        io.out('ERROR: no inject domains found for flow scaling.')
        exit
    endif
    q_scaled = q_scaled / n_inject_domain
    scaled_flowrate = q_scaled
end

