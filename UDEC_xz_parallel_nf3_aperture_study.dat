; =========================================================
; READ INJECTION DATA
; File columns: time, Q, interval pressure, unused pressure column, bleed
; =========================================================

fish define setup_io
    global IO_READ  = 0
    global IO_ASCII = 1
    global max_lines = 100000
end
[setup_io]

fish define read_data
    local raw = array.create(max_lines)
    local status = file.open(filename, IO_READ, IO_ASCII)
    if status # 0 then
        io.out('ERROR: file open failed: ' + filename)
        exit
    endif
    local read_status = file.read(raw, max_lines)
    status = file.close
    if read_status < 0 then
        io.out('ERROR: read error')
        exit
    endif
    if read_status = 0 then
        io.out('ERROR: input file exceeded max_lines before EOF; increase max_lines.')
        exit
    endif
    global n_data = read_status - 1
    if n_data < 1 then
        io.out('ERROR: no data rows found after header in file: ' + filename)
        exit
    endif
    global t_arr = array.create(n_data)
    global Q_arr = array.create(n_data)
    global pint_arr = array.create(n_data)
    global bleed_arr = array.create(n_data)
    loop local i (1, n_data)
        local line = raw(i + 1)
        t_arr(i)     = float(string.token(line,1))
        Q_arr(i)     = float(string.token(line,2))
        pint_arr(i)  = float(string.token(line,3))
        bleed_arr(i) = float(string.token(line,5))
    endloop
    io.out('Injection data loaded. n_data = ' + string(n_data))
end

fish define ApplyWellPressure_xz(reset_inject_, reset_produce_)
    global n_well_pressure_domains = 0
    local d = block.domain.head
    loop while d # 0
        if reset_inject_ # 0 then
            if block.domain.group(d,'5') = 'inject_domain' then
                block.domain.pp(d) = pp0
                n_well_pressure_domains = n_well_pressure_domains + 1
            endif
        endif
        if reset_produce_ # 0 then
            if block.domain.group(d,'5') = 'produce_domain' then
                block.domain.pp(d) = pp0
                n_well_pressure_domains = n_well_pressure_domains + 1
            endif
        endif
        d = block.domain.next(d)
    endloop
end

fish define init_injection_control
    if n_inject_domain < 1 then
        io.out('ERROR: no inject domains found.')
        exit
    endif
    if n_produce_domain < 1 then
        io.out('ERROR: no produce domains found.')
        exit
    endif
    global time_ = 290.8
    global spos_ = 1
    global n_savetime = 11
    global savetime_ = array.create(n_savetime)
    savetime_(1)  = 511.6
    savetime_(2)  = 1059.0
    savetime_(3)  = 1491.6
    savetime_(4)  = 1984.0
    savetime_(5)  = 2050.0
    savetime_(6)  = 2080.0
    savetime_(7)  = 2120.0
    savetime_(8)  = 2200.0
    savetime_(9)  = 2388.0
    savetime_(10) = 2570.0
    savetime_(11) = 10000.0
    io.out('Save-time schedule stored successfully. n_savetime = ' + string(n_savetime))
    loop local isave (1, n_savetime)
        io.out('savetime_(' + string(isave) + ') = ' + string(savetime_(isave)) + ' s')
    endloop
end

fish define run_injection_loop
    loop local i (1,n_data)
        if t_arr(i) > run_stop_time then
            io.out('Requested stop time reached before input row ' + string(i) + ...
                   ': next data time = ' + string(t_arr(i)) + ' s.')
            exit loop
        endif
        local q_now = Q_arr(i)
        local pi_now = pint_arr(i)
        local b_now = bleed_arr(i)
        time_ = time_ + step_size
        local flowrate_ = scaled_flowrate(q_now)
        ; Injection-only stage: keep the production well passive so its
        ; pressure history records the hydraulic response without a sink.
        ;local produce_flowrate_ = scaled_production_flowrate(q_now)
        io.out('q_now = ' + string(q_now))
        io.out('flowrate per domain = ' + string(flowrate_))
        ApplyInjectWellFlow_xz(flowrate_)
        ;ApplyProduceWellFlow_xz(produce_flowrate_)
        commanded_net_well_flow_ = inject_well_flow_total_
        io.out('commanded injection-only well flow = ' + string(commanded_net_well_flow_))
        fl_r_ = q_now
        pi_ = pi_now * 1e6
        bleed_input_ = b_now
        command
            block cycle fluid-time [step_size]
        endcommand
        if i = 1 then
            io.out('Injection/observation-well pressure after the first flow cycle:')
            report_well_domain_pressure
        endif
        ApplyInjectWellFlow_xz(0.0)
        ;ApplyProduceWellFlow_xz(0.0)
        if spos_ <= n_savetime then
            if time_ > savetime_(spos_) then
                local sav_flow = 'UDEC_XZ_FM_parallel_nf3_sp100cm_NUA10-50-20um_dual_well_PRDflow_v' + string(vers) + '_timestep02sec_' + string(int(time_)) + 'sec.3sav'
                command
                    model save [sav_flow]
                endcommand
                spos_ = spos_ + 1
            endif
        endif
    endloop
    local sav_flow_final = 'UDEC_XZ_FM_parallel_nf3_sp100cm_NUA10-50-20um_dual_well_PRDflow_v' + string(vers) + '_timestep02sec_' + string(int(time_)) + 'sec_final.3sav'
    command
        model save [sav_flow_final]
    endcommand
    io.out('Final model saved: ' + sav_flow_final)
    io.out('Final fluid time: ' + string(time_))
end

; =========================================================
; RUN
; =========================================================

[read_data]
[init_injection_control]
[set_fluid_bulk]

[run_injection_loop]
